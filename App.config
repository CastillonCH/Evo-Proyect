<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Cambie [NOMBRE_SERVIDOR] por el nombre de su servidor SQL Server (ej. localhost, .\SQLEXPRESS) -->
        <add name="RestauranteBD"
             connectionString="Server=[NOMBRE_SERVIDOR];Database=restaurante;Trusted_Connection=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
